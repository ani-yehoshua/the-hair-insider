{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "git": {
        "deploymentEnabled": {
            "growth-edit/length-retention-plan-relaunch": false,
            "growth-edit/plan-copy-consistency": false
        }
    },
    "crons": [
        {
            "path": "/api/cron/cleanup-unconfirmed-users",
            "schedule": "0 9 * * *"
        },
        {
            "path": "/api/cron/enroll-solution-audience?run=1",
            "schedule": "0 17 * * *"
        },
        {
            "path": "/api/cron/enroll-solution-audience?run=2",
            "schedule": "0 21 * * *"
        }
    ]
}
